# Electron only: overrides where the SQLite database lives. The packaged
# app sets this automatically to Electron's userData directory - you
# normally don't need to set it for local development.
# APP_DB_PATH=

# Encryption key for secrets stored in the database (AI provider API keys
# and the Gmail app password). Required for self-hosted/web deployments;
# the desktop app generates and keeps one in the OS keychain automatically.
# Generate with: openssl rand -hex 32
# APP_SECRET_KEY=

# Optional: AI provider keys from the environment instead of the Settings
# page. When set, they take precedence over keys saved in the app.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
