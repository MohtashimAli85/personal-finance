# Google OAuth credentials for Gmail sync (Bank Transactions page).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the "Gmail API" scope gmail.readonly, and a redirect URI of
# {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL the app is served from - used to build the OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: skip the interactive OAuth flow entirely by supplying tokens
# directly (useful for scripts/CI). GOOGLE_REFRESH_TOKEN is accepted as an
# alias for GMAIL_REFRESH_TOKEN.
# GMAIL_ACCESS_TOKEN=
# GMAIL_REFRESH_TOKEN=

# Electron only: the custom URL scheme used for the desktop OAuth
# deep-link callback. Defaults to myfinanceapp if unset.
# ELECTRON_DEEP_LINK_SCHEME=myfinanceapp

# Electron only: overrides where the SQLite database lives. The packaged
# app sets this automatically to Electron's userData directory - you
# normally don't need to set it for local development.
# APP_DB_PATH=
