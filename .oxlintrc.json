{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["react", "react-hooks", "nextjs", "typescript", "import"],
	"categories": { "correctness": "error" },
	"ignorePatterns": [
		".next/**",
		"out/**",
		"build/**",
		"next-env.d.ts",
		"release/**",
		"dist-electron/**",
		"backups/**"
	],
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
